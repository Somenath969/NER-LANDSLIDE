# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Backend as a Service)
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL="https://hvqmnwutfppfjkwterca.supabase.co"
VITE_SUPABASE_URL="https://hvqmnwutfppfjkwterca.supabase.co"

# Your Supabase Public Anonymous / Publishable API Key (safe for client/backend)
SUPABASE_ANON_KEY="sb_publishable_way-34fnanwwLVDbPe5ukA_-Sq58IbH"
VITE_SUPABASE_ANON_KEY="sb_publishable_way-34fnanwwLVDbPe5ukA_-Sq58IbH"

# OGD_API_KEY: Open Government Data (data.gov.in) API key for IMD rainfall and weather telemetry
OGD_API_KEY="579b464db66ec23bdd000001515d9e6c218046fc6d6860088baed379"
VITE_OGD_API_KEY="579b464db66ec23bdd000001515d9e6c218046fc6d6860088baed379"

# MapTiler API Key for high-resolution vector, satellite, and terrain GIS basemaps
MAPTILER_API_KEY="PD1myr0t87Z92zHcr5h1"
VITE_MAPTILER_API_KEY="PD1myr0t87Z92zHcr5h1"

# PORT: Server port (Set to 3000 for Render web service)
PORT=3000
